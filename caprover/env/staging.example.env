# Base safe defaults for a protected CapRover staging POC. Do not commit real secrets.
APP_ENV=staging
APP_DEBUG=false
FORCE_HTTPS=true
APP_TRUSTED_PROXIES=*
DB_HOST=srv-captain--st-remp-mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD
REDIS_HOST=srv-captain--st-remp-redis
REDIS_PORT=6379
REMP_SSO_ADDR=https://sso.remp.voltdata.info
REMP_RUN_MIGRATIONS=false
REMP_RUN_SEEDERS=false
