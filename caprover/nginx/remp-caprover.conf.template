resolver 127.0.0.11 valid=30s;

server {
    listen ${NGINX_PORT};
    server_name _;
    root /var/www/html/Beam/public;
    location /healthz { return 200 "ok\n"; }
}

server {
    listen ${NGINX_PORT};
    server_name campaign.remp.voltdata.info;
    root /var/www/html/Campaign/public;
    location / { try_files $uri /index.php$is_args$args; }
    location ~ ^/.+\.php(/|$) { set $upstream ${CAMPAIGN_FPM}; fastcgi_pass $upstream; include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; }
}
server {
    listen ${NGINX_PORT};
    server_name mailer.remp.voltdata.info;
    client_max_body_size 5M;
    root /var/www/html/Mailer/www;
    location / { try_files $uri /index.php$is_args$args; }
    location ~ ^/.+\.php(/|$) { set $upstream ${MAILER_FPM}; fastcgi_pass $upstream; include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; }
}
server {
    listen ${NGINX_PORT};
    server_name beam.remp.voltdata.info;
    root /var/www/html/Beam/public;
    location / { try_files $uri /index.php$is_args$args; }
    location ~ ^/.+\.php(/|$) { set $upstream ${BEAM_FPM}; fastcgi_pass $upstream; include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; }
}
server {
    listen ${NGINX_PORT};
    server_name sso.remp.voltdata.info;
    root /var/www/html/Sso/public;
    location / { try_files $uri /index.php$is_args$args; }
    location ~ ^/.+\.php(/|$) { set $upstream ${SSO_FPM}; fastcgi_pass $upstream; include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; }
}
server {
    listen ${NGINX_PORT};
    server_name tracker.beam.remp.voltdata.info;
    location / { set $upstream ${TRACKER_UPSTREAM}; proxy_pass http://$upstream; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
}
server {
    listen ${NGINX_PORT};
    server_name segments.beam.remp.voltdata.info;
    location / { set $upstream ${SEGMENTS_UPSTREAM}; proxy_pass http://$upstream; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
}
server {
    listen ${NGINX_PORT};
    server_name kibana.beam.remp.voltdata.info;
    location / { set $upstream ${KIBANA_UPSTREAM}; proxy_pass http://$upstream; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
}
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen ${NGINX_PORT};
    server_name mailhog.remp.voltdata.info;
    location / { set $upstream ${MAILHOG_UPSTREAM}; proxy_pass http://$upstream; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade; }
}
